# ═══════════════════════════════════════════════════
# QUTTR ADMIN PANEL — Environment Variables
# ═══════════════════════════════════════════════════

# ─── Backend API & Socket ────────────────────────
NEXT_PUBLIC_API_URL=https://quttr-backend.onrender.com/api/v1
NEXT_PUBLIC_SOCKET_URL=https://quttr-backend.onrender.com

# ─── App Info ────────────────────────────────────
NEXT_PUBLIC_APP_NAME=QUTTR Admin
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_ENV=production

# ─── Database ────────────────────────────────────
# Replace this with your actual MongoDB connection string!
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=quttr_qr

# ─── OmniDimension AI Calling Integration ────────
# This secret matches the code in files 2 to 6 so no one can hack your APIs
OMNI_API_SECRET=quttr_omni_secret_key_2025
